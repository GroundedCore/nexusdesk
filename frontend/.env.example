# Copy this file to .env.development to pre-fill the local administrator login
# form while developing, so the default credentials do not need retyping.
#
# Vite loads .env.development only for `npm run dev` (mode=development). It is
# never read by `npm run build`, so these values cannot reach a shipped bundle.
#
# Use a throwaway development password here, never a real one. The deployment
# default is admin / nexusdesk and it forces a password change on first login.
VITE_DEV_LOGIN_USER=
VITE_DEV_LOGIN_PASSWORD=
